{
  "name": "knowledge-driven-test-platform",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/knowledge-core/test/*.test.js packages/knowledge-registry/test/*.test.js apps/knowledge-cli/test/*.test.js",
    "validate": "node scripts/validate-repository.js",
    "example:approval": "node apps/knowledge-cli/src/cli.js resolve examples/approval-platform",
    "example:registry": "node examples/registry-lifecycle.js"
  }
}
