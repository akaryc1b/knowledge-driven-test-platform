{
  "name": "knowledge-driven-test-platform",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/knowledge-core/test/*.test.js packages/knowledge-registry/test/*.test.js packages/knowledge-registry-postgres/test/*.test.js packages/knowledge-governance/test/*.test.js packages/knowledge-governance-postgres/test/*.test.js packages/governance-query/test/*.test.js packages/project-membership/test/*.test.js packages/project-membership-postgres/test/*.test.js packages/governance-http/test/*.test.js packages/governance-auth-oidc/test/*.test.js apps/knowledge-cli/test/*.test.js",
    "validate": "node scripts/validate-repository.js",
    "example:approval": "node apps/knowledge-cli/src/cli.js resolve examples/approval-platform",
    "example:registry": "node examples/registry-lifecycle.js",
    "example:governance": "node examples/governance-lifecycle.js",
    "example:query": "node examples/read-only-query-api.js",
    "example:access": "node examples/project-membership-authorization.js",
    "example:http": "node examples/read-only-http-transport.js",
    "example:oidc": "node examples/oidc-jwks-authentication.js",
    "test:postgres": "node --test --test-concurrency=1 packages/knowledge-registry-postgres/test/postgres-integration.test.js packages/knowledge-governance-postgres/test/postgres-integration.test.js packages/project-membership-postgres/test/postgres-integration.test.js",
    "example:postgres": "node examples/postgres-registry.js",
    "example:governance:postgres": "node examples/postgres-governance.js"
  }
}
