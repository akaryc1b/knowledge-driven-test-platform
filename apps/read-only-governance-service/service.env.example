KDTP_SERVICE_NAME=kdtp-read-only-governance
KDTP_DATABASE_URL=postgresql://kdtp_user:CHANGE_ME@postgres:5432/kdtp
KDTP_HTTP_HOST=0.0.0.0
KDTP_HTTP_PORT=8080
KDTP_OIDC_ISSUER=https://id.example.com/tenant
KDTP_OIDC_JWKS_URI=https://id.example.com/tenant/.well-known/jwks.json
KDTP_OIDC_AUDIENCE=kdtp-read-api
KDTP_OIDC_SUBJECT_MAPPINGS_JSON=[{"subject":"replace-with-verified-subject","actor":"replace-with-platform-actor"}]
KDTP_RATE_LIMIT_MAX_REQUESTS=120
KDTP_RATE_LIMIT_WINDOW_MS=60000
KDTP_READINESS_TIMEOUT_MS=3000
KDTP_SHUTDOWN_TIMEOUT_MS=10000
