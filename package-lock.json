{
  "name": "knowledge-driven-test-platform",
  "version": "0.2.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "knowledge-driven-test-platform",
      "version": "0.2.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/knowledge-cli": {
      "name": "@kdtp/knowledge-cli",
      "version": "0.1.0",
      "bin": {
        "kdtp-knowledge": "src/cli.js"
      }
    },
    "node_modules/@kdtp/knowledge-cli": {
      "resolved": "apps/knowledge-cli",
      "link": true
    },
    "node_modules/@kdtp/knowledge-core": {
      "resolved": "packages/knowledge-core",
      "link": true
    },
    "node_modules/@kdtp/knowledge-registry": {
      "resolved": "packages/knowledge-registry",
      "link": true
    },
    "packages/knowledge-core": {
      "name": "@kdtp/knowledge-core",
      "version": "0.1.0"
    },
    "packages/knowledge-registry": {
      "name": "@kdtp/knowledge-registry",
      "version": "0.1.0"
    }
  }
}
