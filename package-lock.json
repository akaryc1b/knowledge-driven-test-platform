{
  "name": "knowledge-driven-test-platform",
  "version": "0.6.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "knowledge-driven-test-platform",
      "version": "0.6.0",
      "workspaces": ["apps/*", "packages/*"],
      "engines": { "node": ">=22" }
    },
    "apps/knowledge-cli": {
      "name": "@kdtp/knowledge-cli",
      "version": "0.1.0",
      "bin": { "kdtp-knowledge": "src/cli.js" }
    },
    "node_modules/@kdtp/governance-query": {
      "resolved": "packages/governance-query",
      "link": true
    },
    "node_modules/@kdtp/knowledge-cli": {
      "resolved": "apps/knowledge-cli",
      "link": true
    },
    "node_modules/@kdtp/knowledge-core": {
      "resolved": "packages/knowledge-core",
      "link": true
    },
    "node_modules/@kdtp/knowledge-governance": {
      "resolved": "packages/knowledge-governance",
      "link": true
    },
    "node_modules/@kdtp/knowledge-governance-postgres": {
      "resolved": "packages/knowledge-governance-postgres",
      "link": true
    },
    "node_modules/@kdtp/knowledge-registry": {
      "resolved": "packages/knowledge-registry",
      "link": true
    },
    "node_modules/@kdtp/knowledge-registry-postgres": {
      "resolved": "packages/knowledge-registry-postgres",
      "link": true
    },
    "packages/governance-query": {
      "name": "@kdtp/governance-query",
      "version": "0.1.0",
      "dependencies": {
        "@kdtp/knowledge-core": "0.1.0",
        "@kdtp/knowledge-governance": "0.1.0",
        "@kdtp/knowledge-registry": "0.1.0"
      }
    },
    "packages/knowledge-core": {
      "name": "@kdtp/knowledge-core",
      "version": "0.1.0"
    },
    "packages/knowledge-governance": {
      "name": "@kdtp/knowledge-governance",
      "version": "0.1.0",
      "dependencies": {
        "@kdtp/knowledge-core": "0.1.0",
        "@kdtp/knowledge-registry": "0.1.0"
      }
    },
    "packages/knowledge-governance-postgres": {
      "name": "@kdtp/knowledge-governance-postgres",
      "version": "0.1.0",
      "dependencies": {
        "@kdtp/knowledge-core": "0.1.0",
        "@kdtp/knowledge-governance": "0.1.0",
        "@kdtp/knowledge-registry": "0.1.0",
        "@kdtp/knowledge-registry-postgres": "0.1.0"
      },
      "peerDependencies": { "pg": ">=8.22.0 <9" },
      "peerDependenciesMeta": { "pg": { "optional": true } }
    },
    "packages/knowledge-registry": {
      "name": "@kdtp/knowledge-registry",
      "version": "0.1.0"
    },
    "packages/knowledge-registry-postgres": {
      "name": "@kdtp/knowledge-registry-postgres",
      "version": "0.1.0",
      "dependencies": { "@kdtp/knowledge-registry": "0.1.0" },
      "peerDependencies": { "pg": ">=8.22.0 <9" },
      "peerDependenciesMeta": { "pg": { "optional": true } }
    }
  }
}
