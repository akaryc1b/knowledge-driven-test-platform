[
  {
    "id": "GLOBAL-SEC-001",
    "boundaryKey": "security.secret-log-redaction",
    "name": "日志敏感信息脱敏",
    "version": "1.0.0",
    "status": "PUBLISHED",
    "scope": {
      "level": "GLOBAL",
      "key": "company"
    },
    "enforcement": "mandatory",
    "overridePolicy": "deny",
    "enabled": true,
    "value": {
      "redactHeaders": [
        "authorization",
        "cookie",
        "set-cookie"
      ],
      "redactFields": [
        "password",
        "token",
        "secret"
      ]
    },
    "owner": "quality-platform-team",
    "source": "M0 example",
    "riskLevel": "high"
  },
