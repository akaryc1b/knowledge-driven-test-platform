{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://kdtp.local/schemas/execution/v1/execution-result.schema.json","title":"Execution Result v1","type":"object","additionalProperties":false,"required":["schemaVersion","resultId","requestId","requestDigest","adapter","state","startedAt","completedAt","stateHistory","outputArtifacts","measurements","failure","cancellation","resultDigest"],"properties":{"schemaVersion":{"const":"execution-result/v1"},"resultId":{"type":"string","pattern":"^result-[a-f0-9]{16}$"},"requestId":{"type":"string","pattern":"^exec-[a-z0-9-]+-[a-f0-9]{16}$"},"requestDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"adapter":{"type":"object","additionalProperties":false,"required":["adapterId","adapterType","version","descriptorDigest"],"properties":{"adapterId":{"type":"string","pattern":"^adapter-[a-z0-9-]+-[a-f0-9]{12}$"},"adapterType":{"enum":["k6-api","k6-performance","k6-browser","k6-websocket","xk6-extension"]},"version":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},"descriptorDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},"state":{"enum":["SUCCEEDED","FAILED","CANCELLED","TIMED_OUT"]},"startedAt":{"type":"string","format":"date-time"},"completedAt":{"type":"string","format":"date-time"},"stateHistory":{"type":"array","minItems":2,"maxItems":100,"items":{"type":"object","additionalProperties":false,"required":["state","at"],"properties":{"state":{"enum":["PENDING","VALIDATED","REJECTED","RUNNING","CANCELLATION_REQUESTED","SUCCEEDED","FAILED","CANCELLED","TIMED_OUT"]},"at":{"type":"string","format":"date-time"},"reason":{"type":"string","minLength":1,"maxLength":256}}}},"outputArtifacts":{"type":"array","maxItems":1000,"items":{"type":"object","additionalProperties":false,"required":["artifactId","kind","mediaType","digest","uri"],"properties":{"artifactId":{"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{2,255}$"},"kind":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:[