{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.local/schemas/execution/k6-api-runtime/v1/k6-trusted-output-root-port.schema.json",
  "title": "K6 Trusted Output Root Port",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "portId",
    "portVersion",
    "implementationStatus",
    "ownership",
    "capabilities",
    "portDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "k6-trusted-output-root-port/v1"
    },
    "portId": {
      "const": "k6-trusted-output-root-port"
    },
    "portVersion": {
      "const": "1.0.0"
    },
    "implementationStatus": {
      "const": "INJECTED_FAKE_ONLY"
    },
    "ownership": {
      "const": "PLATFORM_OWNED"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocateLogicalRoot",
        "resolveDeclaredArtifact",
        "createRealDirectory",
        "accessRealFilesystem",
        "returnHostPath",
        "openFile",
        "readFile",
        "writeFile",
        "recursivelyDiscover"
      ],
      "properties": {
        "allocateLogicalRoot": {
          "const": true
        },
        "resolveDeclaredArtifact": {
          "const": true
        },
        "createRealDirectory": {
          "const": false
        },
        "accessRealFilesystem": {
          "const": false
        },
        "returnHostPath": {
          "const": false
        },
        "openFile": {
          "const": false
        },
        "readFile": {
          "const": false
        },
        "writeFile": {
          "const": false
        },
        "recursivelyDiscover": {
          "const": false
        }
      }
    },
    "portDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
