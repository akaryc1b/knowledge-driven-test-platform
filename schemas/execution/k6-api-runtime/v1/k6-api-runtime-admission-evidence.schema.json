{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.local/schemas/execution/k6-api-runtime/v1/k6-api-runtime-admission-evidence.schema.json",
  "title": "K6 API Runtime Admission Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "admissionId",
    "admissionDigest",
    "planId",
    "planDigest",
    "executionRequestDigest",
    "sourceBundleDigest",
    "sourceDigest",
    "decision",
    "safetyBoundary",
    "evidenceDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "k6-api-runtime-admission-evidence/v1" },
    "evidenceId": {
      "type": "string",
      "pattern": "^k6runtime-evidence-[a-f0-9]{20}$"
    },
    "admissionId": {
      "type": "string",
      "pattern": "^k6runtime-admission-[a-f0-9]{20}$"
    },
    "admissionDigest": { "$ref": "#/$defs/digest" },
    "planId": {
      "type": "string",
      "pattern": "^k6invocation-[a-f0-9]{20}$"
    },
    "planDigest": { "$ref": "#/$defs/digest" },
    "executionRequestDigest": { "$ref": "#/$defs/digest" },
    "sourceBundleDigest": { "$ref": "#/$defs/digest" },
    "sourceDigest": { "$ref": "#/$defs/digest" },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeAdmissionContractReady",
        "invocationPlanReady",
        "executionImplementationStarted",
        "sourceExecuted",
        "k6Invoked",
        "externalProcessExecuted",
        "nextRequiredSlice",
        "repositoryBlockers"
      ],
      "properties": {
        "runtimeAdmissionContractReady": { "const": true },
        "invocationPlanReady": { "const": true },
        "executionImplementationStarted": { "const": false },
        "sourceExecuted": { "const": false },
        "k6Invoked": { "const": false },
        "externalProcessExecuted": { "const": false },
        "nextRequiredSlice": { "const": "M3-R3-P1" },
        "repositoryBlockers": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "safetyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceExecuted",
        "executionRuntimeStarted",
        "k6Invoked",
        "xk6Invoked",
        "playwrightInvoked",
        "externalProcessExecuted",
        "shellUsed",
        "nodeVmUsed",
        "evalUsed",
        "dynamicImportUsed",
        "targetNetworkAccessed",
        "databaseAccessed",
        "secretAccessed",
        "filesystemCredentialAccessed",
        "temporaryExecutionDirectoryCreated",
        "containerStarted",
        "kubernetesResourceCreated",
        "workerAdded",
        "queueAdded",
        "schedulerAdded",
        "runtimeResultCollected",
        "allureImplemented"
      ],
      "properties": {
        "sourceExecuted": { "const": false },
        "executionRuntimeStarted": { "const": false },
        "k6Invoked": { "const": false },
        "xk6Invoked": { "const": false },
        "playwrightInvoked": { "const": false },
        "externalProcessExecuted": { "const": false },
        "shellUsed": { "const": false },
        "nodeVmUsed": { "const": false },
        "evalUsed": { "const": false },
        "dynamicImportUsed": { "const": false },
        "targetNetworkAccessed": { "const": false },
        "databaseAccessed": { "const": false },
        "secretAccessed": { "const": false },
        "filesystemCredentialAccessed": { "const": false },
        "temporaryExecutionDirectoryCreated": { "const": false },
        "containerStarted": { "const": false },
        "kubernetesResourceCreated": { "const": false },
        "workerAdded": { "const": false },
        "queueAdded": { "const": false },
        "schedulerAdded": { "const": false },
        "runtimeResultCollected": { "const": false },
        "allureImplemented": { "const": false }
      }
    },
    "evidenceDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
