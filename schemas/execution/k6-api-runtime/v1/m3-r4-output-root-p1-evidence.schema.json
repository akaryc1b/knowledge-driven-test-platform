{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.local/schemas/execution/k6-api-runtime/v1/m3-r4-output-root-p1-evidence.schema.json",
  "title": "M3-R4-P1 Output Root Contract Evidence",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "skipped", "failed"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "failed": { "const": 0 }
      }
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "source",
    "acceptedR0",
    "contracts",
    "testResults",
    "decision",
    "safetyBoundary",
    "evidenceDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "m3-r4-output-root-p1-evidence/v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commitSha"],
      "properties": {
        "branch": { "type": "string", "minLength": 1, "maxLength": 256 },
        "commitSha": {
          "type": "string",
          "pattern": "^(?:local|[a-f0-9]{40})$"
        }
      }
    },
    "acceptedR0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "pullRequest",
        "baseMain",
        "headSha",
        "naturalWorkflowCount",
        "naturalWorkflowSuccess",
        "changedPathCount"
      ],
      "properties": {
        "issue": { "const": 77 },
        "pullRequest": { "const": 78 },
        "baseMain": { "const": "6737436f6c0f46d1ca5a2a48f0adc0c25c0771fa" },
        "headSha": { "const": "e522c13065dd77770d414a727d030a5108488eae" },
        "naturalWorkflowCount": { "const": 11 },
        "naturalWorkflowSuccess": { "const": 11 },
        "changedPathCount": { "const": 8 }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policySchema",
        "descriptorSchema",
        "rootContractSchema",
        "evidenceSchema",
        "policyDigest",
        "descriptorDigest",
        "rootContractId",
        "rootContractDigest",
        "schemaCatalogDigest",
        "artifactDescriptorCount",
        "lifecycleStateCount",
        "compatibilityProductDigest"
      ],
      "properties": {
        "policySchema": { "const": "k6-governed-output-root-policy/v1" },
        "descriptorSchema": { "const": "k6-output-artifact-descriptor/v1" },
        "rootContractSchema": { "const": "k6-governed-output-root-contract/v1" },
        "evidenceSchema": { "const": "m3-r4-output-root-p1-evidence/v1" },
        "policyDigest": { "$ref": "#/$defs/digest" },
        "descriptorDigest": { "$ref": "#/$defs/digest" },
        "rootContractId": {
          "type": "string",
          "pattern": "^k6output-root-contract-[a-f0-9]{20}$"
        },
        "rootContractDigest": { "$ref": "#/$defs/digest" },
        "schemaCatalogDigest": { "$ref": "#/$defs/digest" },
        "artifactDescriptorCount": { "const": 1 },
        "lifecycleStateCount": { "const": 7 },
        "compatibilityProductDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "testResults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focusedNode22", "focusedNode24", "k6ApiAdapter", "fullNode", "repositoryValidator"],
      "properties": {
        "focusedNode22": { "$ref": "#/$defs/testResult" },
        "focusedNode24": { "$ref": "#/$defs/testResult" },
        "k6ApiAdapter": { "$ref": "#/$defs/testResult" },
        "fullNode": { "$ref": "#/$defs/testResult" },
        "repositoryValidator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "const": "success" }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputRootContractReady",
        "outputRootSchemaCatalogReady",
        "logicalRootIdentityDefined",
        "artifactDescriptorsDefined",
        "lifecycleGrammarDefined",
        "governedOutputRootImplemented",
        "outputDirectoryCreated",
        "outputDirectoryAllocated",
        "filesystemPortImplemented",
        "fileResultCollectionSupported",
        "fileResultCollectionImplemented",
        "nextRequiredSlice",
        "repositoryBlockers"
      ],
      "properties": {
        "outputRootContractReady": { "const": true },
        "outputRootSchemaCatalogReady": { "const": true },
        "logicalRootIdentityDefined": { "const": true },
        "artifactDescriptorsDefined": { "const": true },
        "lifecycleGrammarDefined": { "const": true },
        "governedOutputRootImplemented": { "const": false },
        "outputDirectoryCreated": { "const": false },
        "outputDirectoryAllocated": { "const": false },
        "filesystemPortImplemented": { "const": false },
        "fileResultCollectionSupported": { "const": false },
        "fileResultCollectionImplemented": { "const": false },
        "nextRequiredSlice": { "const": "M3-R4-P2" },
        "repositoryBlockers": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        }
      }
    },
    "safetyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputDirectoryCreated",
        "outputDirectoryAllocated",
        "filesystemPortImplemented",
        "fileOpened",
        "fileRead",
        "fileWritten",
        "arbitraryFileReadEnabled",
        "callerPathAccepted",
        "absolutePathAccepted",
        "sourceBundleMutated",
        "invocationPlanModified",
        "nodeProcessAdapterModified",
        "newProcessPrimitiveAdded",
        "k6Invoked",
        "xk6Invoked",
        "playwrightInvoked",
        "realExternalProcessStartedInCi",
        "targetNetworkAccessed",
        "databaseAccessed",
        "secretAccessed",
        "filesystemCredentialAccessed",
        "rawStdoutCollected",
        "rawStderrCollected",
        "numericPidExposed",
        "workerAdded",
        "queueAdded",
        "schedulerAdded",
        "containerExecutionAdded",
        "kubernetesExecutionAdded",
        "remoteExecutionApiAdded",
        "allureImplemented",
        "m4Started"
      ],
      "properties": {
        "outputDirectoryCreated": { "const": false },
        "outputDirectoryAllocated": { "const": false },
        "filesystemPortImplemented": { "const": false },
        "fileOpened": { "const": false },
        "fileRead": { "const": false },
        "fileWritten": { "const": false },
        "arbitraryFileReadEnabled": { "const": false },
        "callerPathAccepted": { "const": false },
        "absolutePathAccepted": { "const": false },
        "sourceBundleMutated": { "const": false },
        "invocationPlanModified": { "const": false },
        "nodeProcessAdapterModified": { "const": false },
        "newProcessPrimitiveAdded": { "const": false },
        "k6Invoked": { "const": false },
        "xk6Invoked": { "const": false },
        "playwrightInvoked": { "const": false },
        "realExternalProcessStartedInCi": { "const": false },
        "targetNetworkAccessed": { "const": false },
        "databaseAccessed": { "const": false },
        "secretAccessed": { "const": false },
        "filesystemCredentialAccessed": { "const": false },
        "rawStdoutCollected": { "const": false },
        "rawStderrCollected": { "const": false },
        "numericPidExposed": { "const": false },
        "workerAdded": { "const": false },
        "queueAdded": { "const": false },
        "schedulerAdded": { "const": false },
        "containerExecutionAdded": { "const": false },
        "kubernetesExecutionAdded": { "const": false },
        "remoteExecutionApiAdded": { "const": false },
        "allureImplemented": { "const": false },
        "m4Started": { "const": false }
      }
    },
    "evidenceDigest": { "$ref": "#/$defs/digest" }
  }
}
