{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kdtp.local/execution/k6-api-runtime/v1/m3-r3-g4-final-main-run-manifest.schema.json",
  "title": "M3-R3 G4 Final Exact-Main Natural Workflow Manifest Evidence",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "conclusion"
      ],
      "properties": {
        "id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "conclusion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workflowId",
        "name",
        "attempt",
        "event",
        "headBranch",
        "headSha",
        "status",
        "conclusion",
        "jobs"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "workflowId": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "attempt": {
          "const": 1
        },
        "event": {
          "enum": [
            "pull_request",
            "push"
          ]
        },
        "headBranch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "headSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "conclusion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "jobs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/job"
          }
        }
      }
    },
    "runSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitSha",
        "workflowCount",
        "workflowNames",
        "runs"
      ],
      "properties": {
        "commitSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        },
        "workflowCount": {
          "type": "integer",
          "minimum": 0
        },
        "workflowNames": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "runs": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/run"
          }
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "repository",
    "source",
    "baseline",
    "pullRequest",
    "acceptedHead",
    "exactMain",
    "collector",
    "validation",
    "artifact",
    "decision",
    "safetyBoundary",
    "evidenceDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "m3-r3-g4-final-main-run-manifest/v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "const": "akaryc1b/knowledge-driven-test-platform"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventName",
        "mode",
        "branch",
        "commitSha",
        "runId",
        "runAttempt"
      ],
      "properties": {
        "eventName": {
          "enum": [
            "pull_request",
            "push"
          ]
        },
        "mode": {
          "enum": [
            "pre-merge-contract",
            "exact-main-manifest"
          ]
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "runId": {
          "type": "integer",
          "minimum": 1
        },
        "runAttempt": {
          "const": 1
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "observerPullRequest",
        "observerHead",
        "observerMerge",
        "observerExactMainRun",
        "observerExactMainValidationJob",
        "observerExactMainReportJob",
        "observerExactMainArtifact",
        "observerExactMainArtifactApiDigest",
        "observerExactMainCanonicalEvidenceDigest",
        "historicalEvidenceRewritten",
        "manualRerunPerformed"
      ],
      "properties": {
        "issue": {
          "const": 75
        },
        "observerPullRequest": {
          "const": 74
        },
        "observerHead": {
          "const": "e67ec1f8e63b7ba2332bbe41ba40b453326b5985"
        },
        "observerMerge": {
          "const": "cdecd4e28cc9426b41c7f21d6fcd319f9ab8b3f9"
        },
        "observerExactMainRun": {
          "const": 31145384797
        },
        "observerExactMainValidationJob": {
          "const": 92763605254
        },
        "observerExactMainReportJob": {
          "const": 92763675300
        },
        "observerExactMainArtifact": {
          "const": 8981282157
        },
        "observerExactMainArtifactApiDigest": {
          "const": "sha256:e51c5b6f7918e2e7077f1b71bee19ad70907bcfa1d4f06794d55e0811f9cbea8"
        },
        "observerExactMainCanonicalEvidenceDigest": {
          "const": "04412a6b1569cdbfb004203c3d2d12d46bd1c2645846233b95304bb1873a25df"
        },
        "historicalEvidenceRewritten": {
          "const": false
        },
        "manualRerunPerformed": {
          "const": false
        }
      }
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "state",
        "draft",
        "merged",
        "baseSha",
        "headSha",
        "mergeSha",
        "parents"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "open",
            "closed"
          ]
        },
        "draft": {
          "type": "boolean"
        },
        "merged": {
          "type": "boolean"
        },
        "baseSha": {
          "const": "cdecd4e28cc9426b41c7f21d6fcd319f9ab8b3f9"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "mergeSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        },
        "parents": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      }
    },
    "acceptedHead": {
      "$ref": "#/$defs/runSet"
    },
    "exactMain": {
      "$ref": "#/$defs/runSet"
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowName",
        "currentRunId",
        "validationJob",
        "reportJob",
        "reportJobExternalVerificationRequired"
      ],
      "properties": {
        "workflowName": {
          "const": "m3-r3-g4-final-main-run-manifest"
        },
        "currentRunId": {
          "type": "integer",
          "minimum": 0
        },
        "validationJob": {
          "$ref": "#/$defs/job"
        },
        "reportJob": {
          "$ref": "#/$defs/job"
        },
        "reportJobExternalVerificationRequired": {
          "type": "boolean"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focusedStatus",
        "rootValidationStatus",
        "dedicatedValidatorStatus"
      ],
      "properties": {
        "focusedStatus": {
          "const": "success"
        },
        "rootValidationStatus": {
          "const": "success"
        },
        "dedicatedValidatorStatus": {
          "const": "success"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "expectedPaths",
        "pathCount",
        "preUploadAudit"
      ],
      "properties": {
        "name": {
          "const": "m3-r3-g4-final-main-run-manifest-evidence"
        },
        "expectedPaths": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "enum": [
              "evidence/m3-r3-g4-final-main-run-manifest.json",
              "schemas/execution/k6-api-runtime/v1/m3-r3-g4-final-main-run-manifest.schema.json",
              "scripts/m3-r3-g4-final-main-run-manifest.js",
              "scripts/json-schema-draft-2020.js",
              "packages/k6-api-adapter/test/m3-r3-g4-final-main-run-manifest.test.js",
              ".github/workflows/m3-r3-g4-final-main-run-manifest.yml",
              "docs/04-governance/m3-r3-g4-final-main-run-manifest.md",
              "schemas/execution/k6-api-runtime/README.md",
              "logs/m3-r3-g4-final-main-run-manifest-focused-node22.tap",
              "logs/m3-r3-g4-final-main-run-manifest-root-validation.log",
              "logs/m3-r3-g4-final-main-run-manifest-validator.log"
            ]
          }
        },
        "pathCount": {
          "const": 11
        },
        "preUploadAudit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "missingEntries",
            "unexpectedEntries",
            "regularFilesOnly",
            "unsafePathEntries",
            "symlinkEntries",
            "specialFileEntries",
            "unicodeNormalizationCollisions",
            "caseFoldCollisions",
            "credentialShapedMatches"
          ],
          "properties": {
            "missingEntries": {
              "const": 0
            },
            "unexpectedEntries": {
              "const": 0
            },
            "regularFilesOnly": {
              "const": true
            },
            "unsafePathEntries": {
              "const": 0
            },
            "symlinkEntries": {
              "const": 0
            },
            "specialFileEntries": {
              "const": 0
            },
            "unicodeNormalizationCollisions": {
              "const": 0
            },
            "caseFoldCollisions": {
              "const": 0
            },
            "credentialShapedMatches": {
              "const": 0
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractValidated",
        "manifestComplete",
        "finalClosureEligible",
        "nextRequiredAction",
        "repositoryBlockers"
      ],
      "properties": {
        "contractValidated": {
          "const": true
        },
        "manifestComplete": {
          "type": "boolean"
        },
        "finalClosureEligible": {
          "const": false
        },
        "nextRequiredAction": {
          "enum": [
            "independent-exact-head-acceptance-and-ordinary-merge",
            "external-report-job-verification-and-independent-artifact-audit"
          ]
        },
        "repositoryBlockers": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "safetyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "k6Invoked",
        "xk6Invoked",
        "playwrightInvoked",
        "externalProcessExecuted",
        "targetNetworkAccessed",
        "databaseAccessed",
        "secretAccessed",
        "filesystemCredentialAccessed",
        "rawStdoutCollected",
        "rawStderrCollected",
        "numericProcessIdExposed",
        "sourceBundleModified",
        "governedOutputRootImplemented",
        "fileResultCollectionImplemented",
        "workerAdded",
        "queueAdded",
        "schedulerAdded",
        "containerStarted",
        "kubernetesResourceCreated",
        "remoteExecutionApiAdded",
        "allureImplemented"
      ],
      "properties": {
        "k6Invoked": {
          "const": false
        },
        "xk6Invoked": {
          "const": false
        },
        "playwrightInvoked": {
          "const": false
        },
        "externalProcessExecuted": {
          "const": false
        },
        "targetNetworkAccessed": {
          "const": false
        },
        "databaseAccessed": {
          "const": false
        },
        "secretAccessed": {
          "const": false
        },
        "filesystemCredentialAccessed": {
          "const": false
        },
        "rawStdoutCollected": {
          "const": false
        },
        "rawStderrCollected": {
          "const": false
        },
        "numericProcessIdExposed": {
          "const": false
        },
        "sourceBundleModified": {
          "const": false
        },
        "governedOutputRootImplemented": {
          "const": false
        },
        "fileResultCollectionImplemented": {
          "const": false
        },
        "workerAdded": {
          "const": false
        },
        "queueAdded": {
          "const": false
        },
        "schedulerAdded": {
          "const": false
        },
        "containerStarted": {
          "const": false
        },
        "kubernetesResourceCreated": {
          "const": false
        },
        "remoteExecutionApiAdded": {
          "const": false
        },
        "allureImplemented": {
          "const": false
        }
      }
    },
    "evidenceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
