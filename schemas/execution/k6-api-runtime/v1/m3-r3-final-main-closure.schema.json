{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.local/schemas/m3-r3-final-main-closure-v1.json",
  "title": "M3-R3 Final Main Closure Observer Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "repository",
    "source",
    "main",
    "sourceMerge",
    "correctionMerge",
    "observer",
    "naturalRuns",
    "artifacts",
    "fixedDigests",
    "validation",
    "artifact",
    "decision",
    "safetyBoundary",
    "evidenceDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "m3-r3-final-main-closure/v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "const": "akaryc1b/knowledge-driven-test-platform"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventName",
        "branch",
        "commitSha",
        "runId",
        "runAttempt"
      ],
      "properties": {
        "eventName": {
          "enum": [
            "pull_request",
            "push"
          ]
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "runId": {
          "type": "integer",
          "minimum": 1
        },
        "runAttempt": {
          "const": 1
        }
      }
    },
    "main": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedSha",
        "requiredPreObserverSha"
      ],
      "properties": {
        "observedSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "requiredPreObserverSha": {
          "const": "c34c9e8234713f109bc98ff3b7ed663066083875"
        }
      }
    },
    "sourceMerge": {
      "$ref": "#/$defs/merge"
    },
    "correctionMerge": {
      "$ref": "#/$defs/merge"
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pullRequest",
        "headSha",
        "mergeSha",
        "parents",
        "merged"
      ],
      "properties": {
        "pullRequest": {
          "type": "integer",
          "minimum": 1
        },
        "headSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "mergeSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        },
        "parents": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        },
        "merged": {
          "type": "boolean"
        }
      }
    },
    "naturalRuns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceMerge",
        "correctionMerge"
      ],
      "properties": {
        "sourceMerge": {
          "$ref": "#/$defs/runSet"
        },
        "correctionMerge": {
          "$ref": "#/$defs/runSet"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceMergeG1",
        "correctionMergeC1"
      ],
      "properties": {
        "sourceMergeG1": {
          "$ref": "#/$defs/artifact"
        },
        "correctionMergeC1": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "fixedDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptedP4CanonicalEvidence",
        "acceptedP4SchemaCatalog",
        "acceptedG1CanonicalEvidence",
        "acceptedG1SchemaCatalog",
        "scopeManifest",
        "compatibilityProduct",
        "correctionPrCanonicalEvidence",
        "correctionPrArtifactApi"
      ],
      "properties": {
        "acceptedP4CanonicalEvidence": {
          "const": "545598fd64f9907db51e1683b5de72623e4575ad05fe530f806fbfba1b7cbfb6"
        },
        "acceptedP4SchemaCatalog": {
          "const": "9fa80d60a744d4c99485596d8a0d89deb7da0a3e67408b21c87236a6cc414de6"
        },
        "acceptedG1CanonicalEvidence": {
          "const": "3d77b61234e060777e12a555314320db3b3a83083cff5c5fbfcafc7bb930298c"
        },
        "acceptedG1SchemaCatalog": {
          "const": "cde2f3a7e41b0bc53cf8a7245d4147c64f842837da0d5ccc229df6f39cc7bbe4"
        },
        "scopeManifest": {
          "const": "01bd484fb5330eb075d1e0ff47df4c9063040176eaaecc86671d9e7480ec99e8"
        },
        "compatibilityProduct": {
          "const": "9bf593893d370448ece828710969eb3b838951ae6e4df5a82c462b1b23d739dd"
        },
        "correctionPrCanonicalEvidence": {
          "const": "3be035b0d0d581e851dc3afa5be28750f2f00d5347aa5e5444e205fbb9eccc6a"
        },
        "correctionPrArtifactApi": {
          "const": "sha256:d4f5a63621045690861a2a2d4417cfffbb251c0c7fb93503d29fa9e4e13be1f8"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focusedStatus",
        "rootValidationStatus",
        "observerValidatorStatus"
      ],
      "properties": {
        "focusedStatus": {
          "const": "success"
        },
        "rootValidationStatus": {
          "const": "success"
        },
        "observerValidatorStatus": {
          "const": "success"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "expectedPaths",
        "pathCount",
        "preUploadAudit"
      ],
      "properties": {
        "name": {
          "const": "m3-r3-final-main-observer-evidence"
        },
        "expectedPaths": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "pathCount": {
          "const": 16
        },
        "preUploadAudit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "missingEntries",
            "unexpectedEntries",
            "regularFilesOnly",
            "unsafePathEntries",
            "symlinkEntries",
            "specialFileEntries",
            "unicodeNormalizationCollisions",
            "caseFoldCollisions",
            "credentialShapedMatches"
          ],
          "properties": {
            "missingEntries": {
              "const": 0
            },
            "unexpectedEntries": {
              "const": 0
            },
            "regularFilesOnly": {
              "const": true
            },
            "unsafePathEntries": {
              "const": 0
            },
            "symlinkEntries": {
              "const": 0
            },
            "specialFileEntries": {
              "const": 0
            },
            "unicodeNormalizationCollisions": {
              "const": 0
            },
            "caseFoldCollisions": {
              "const": 0
            },
            "credentialShapedMatches": {
              "const": 0
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceMergeExactMainVerified",
        "correctionMergeExactMainVerified",
        "observerPullRequestVerified",
        "observerMerged",
        "finalClosureEligible",
        "nextRequiredAction",
        "repositoryBlockers"
      ],
      "properties": {
        "sourceMergeExactMainVerified": {
          "const": true
        },
        "correctionMergeExactMainVerified": {
          "const": true
        },
        "observerPullRequestVerified": {
          "const": true
        },
        "observerMerged": {
          "type": "boolean"
        },
        "finalClosureEligible": {
          "type": "boolean"
        },
        "nextRequiredAction": {
          "enum": [
            "ready-and-ordinary-merge-commit",
            "independent-artifact-audit-and-issue-closure"
          ]
        },
        "repositoryBlockers": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "safetyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "k6Invoked",
        "xk6Invoked",
        "playwrightInvoked",
        "externalProcessExecuted",
        "targetNetworkAccessed",
        "databaseAccessed",
        "secretAccessed",
        "filesystemCredentialAccessed",
        "rawStdoutCollected",
        "rawStderrCollected",
        "numericProcessIdExposed",
        "sourceBundleModified",
        "governedOutputRootImplemented",
        "fileResultCollectionImplemented",
        "workerAdded",
        "queueAdded",
        "schedulerAdded",
        "containerStarted",
        "kubernetesResourceCreated",
        "remoteExecutionApiAdded",
        "allureImplemented"
      ],
      "properties": {
        "k6Invoked": {
          "const": false
        },
        "xk6Invoked": {
          "const": false
        },
        "playwrightInvoked": {
          "const": false
        },
        "externalProcessExecuted": {
          "const": false
        },
        "targetNetworkAccessed": {
          "const": false
        },
        "databaseAccessed": {
          "const": false
        },
        "secretAccessed": {
          "const": false
        },
        "filesystemCredentialAccessed": {
          "const": false
        },
        "rawStdoutCollected": {
          "const": false
        },
        "rawStderrCollected": {
          "const": false
        },
        "numericProcessIdExposed": {
          "const": false
        },
        "sourceBundleModified": {
          "const": false
        },
        "governedOutputRootImplemented": {
          "const": false
        },
        "fileResultCollectionImplemented": {
          "const": false
        },
        "workerAdded": {
          "const": false
        },
        "queueAdded": {
          "const": false
        },
        "schedulerAdded": {
          "const": false
        },
        "containerStarted": {
          "const": false
        },
        "kubernetesResourceCreated": {
          "const": false
        },
        "remoteExecutionApiAdded": {
          "const": false
        },
        "allureImplemented": {
          "const": false
        }
      }
    },
    "evidenceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "conclusion"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "status": {
          "const": "completed"
        },
        "conclusion": {
          "const": "success"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workflowId",
        "name",
        "event",
        "headBranch",
        "headSha",
        "attempt",
        "status",
        "conclusion",
        "jobs"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "workflowId": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "event": {
          "const": "push"
        },
        "headBranch": {
          "const": "main"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "attempt": {
          "const": 1
        },
        "status": {
          "const": "completed"
        },
        "conclusion": {
          "const": "success"
        },
        "jobs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/job"
          }
        }
      }
    },
    "runSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitSha",
        "expectedWorkflowNames",
        "workflowCount",
        "runs"
      ],
      "properties": {
        "commitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "expectedWorkflowNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "workflowCount": {
          "type": "integer",
          "minimum": 1
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/run"
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "runId",
        "headSha",
        "sizeBytes",
        "apiDigest",
        "expired",
        "createdAt",
        "expiresAt"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "runId": {
          "type": "integer",
          "minimum": 1
        },
        "headSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "apiDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "expired": {
          "const": false
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pullRequest",
        "baseSha",
        "headSha",
        "mergeSha",
        "parents"
      ],
      "properties": {
        "pullRequest": {
          "type": "integer",
          "minimum": 1
        },
        "baseSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "mergeSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "parents": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      }
    }
  }
}
