{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.local/schemas/execution/k6-api-runtime/v1/k6-governed-output-root-contract.schema.json",
  "title": "K6 Governed Output Root Contract",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "descriptorId",
        "kind",
        "relativePath",
        "mediaType",
        "encoding",
        "required",
        "regularFileRequired",
        "symbolicLinkAllowed",
        "hardLinkAllowed",
        "specialFileAllowed",
        "maxBytes",
        "parser",
        "descriptorDigest"
      ],
      "properties": {
        "schemaVersion": { "const": "k6-output-artifact-descriptor/v1" },
        "descriptorId": { "const": "k6-output-summary-json" },
        "kind": { "const": "k6-run-summary-json" },
        "relativePath": { "const": "outputs/summary.json" },
        "mediaType": { "const": "application/json" },
        "encoding": { "const": "UTF-8" },
        "required": { "const": true },
        "regularFileRequired": { "const": true },
        "symbolicLinkAllowed": { "const": false },
        "hardLinkAllowed": { "const": false },
        "specialFileAllowed": { "const": false },
        "maxBytes": { "const": 1048576 },
        "parser": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "maxDepth",
            "duplicateKeyPolicy",
            "bomAllowed"
          ],
          "properties": {
            "kind": { "const": "JSON" },
            "maxDepth": { "const": 32 },
            "duplicateKeyPolicy": { "const": "REJECT" },
            "bomAllowed": { "const": false }
          }
        },
        "descriptorDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "enum": [
            "DECLARED",
            "ALLOCATED",
            "ACTIVE",
            "TERMINAL_OBSERVED",
            "SEALED",
            "COLLECTED",
            "CLEANED"
          ]
        },
        "to": {
          "enum": [
            "DECLARED",
            "ALLOCATED",
            "ACTIVE",
            "TERMINAL_OBSERVED",
            "SEALED",
            "COLLECTED",
            "CLEANED"
          ]
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "rootContractId",
    "contractVersion",
    "implementationStatus",
    "predecessor",
    "policyDigest",
    "artifacts",
    "lifecycle",
    "effects",
    "contractDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "k6-governed-output-root-contract/v1" },
    "rootContractId": {
      "type": "string",
      "pattern": "^k6output-root-contract-[a-f0-9]{20}$"
    },
    "contractVersion": { "const": "1.0.0" },
    "implementationStatus": { "const": "CONTRACT_ONLY" },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimePolicyDigest",
        "runtimeAdmissionRequestDigest",
        "invocationPlanDigest",
        "runtimeAdmissionEvidenceDigest",
        "runtimeExecutionEvidenceDigest",
        "sourceBundleDigest",
        "sourceDigest",
        "runtimeOutcomeDigest"
      ],
      "properties": {
        "runtimePolicyDigest": { "$ref": "#/$defs/digest" },
        "runtimeAdmissionRequestDigest": { "$ref": "#/$defs/digest" },
        "invocationPlanDigest": { "$ref": "#/$defs/digest" },
        "runtimeAdmissionEvidenceDigest": { "$ref": "#/$defs/digest" },
        "runtimeExecutionEvidenceDigest": { "$ref": "#/$defs/digest" },
        "sourceBundleDigest": { "$ref": "#/$defs/digest" },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "runtimeOutcomeDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "policyDigest": { "$ref": "#/$defs/digest" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialState",
        "currentState",
        "states",
        "transitions",
        "allocationAuthorized",
        "collectionAuthorized",
        "cleanupAuthorized"
      ],
      "properties": {
        "initialState": { "const": "DECLARED" },
        "currentState": { "const": "DECLARED" },
        "states": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "DECLARED",
              "ALLOCATED",
              "ACTIVE",
              "TERMINAL_OBSERVED",
              "SEALED",
              "COLLECTED",
              "CLEANED"
            ]
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/transition" }
        },
        "allocationAuthorized": { "const": false },
        "collectionAuthorized": { "const": false },
        "cleanupAuthorized": { "const": false }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directoryAllocated",
        "fileOpened",
        "fileRead",
        "fileWritten",
        "processBoundaryChanged"
      ],
      "properties": {
        "directoryAllocated": { "const": false },
        "fileOpened": { "const": false },
        "fileRead": { "const": false },
        "fileWritten": { "const": false },
        "processBoundaryChanged": { "const": false }
      }
    },
    "contractDigest": { "$ref": "#/$defs/digest" }
  }
}
