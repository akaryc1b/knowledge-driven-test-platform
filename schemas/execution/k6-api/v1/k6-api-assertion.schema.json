{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://kdtp.local/schemas/execution/k6-api/v1/k6-api-assertion.schema.json","title":"K6 API Assertion v1","type":"object","additionalProperties":false,"required":["schemaVersion","assertionId","kind","operator"],"properties":{"schemaVersion":{"const":"k6-api-assertion/v1"},"assertionId":{"type":"string","pattern":"^k6assert-[a-f0-9]{20}$"},"kind":{"enum":["STATUS_CODE_IN","JSON_PATH_EXISTS","JSON_PATH_EQUALS"]},"operator":{"enum":["IN","EXISTS","EQUALS"]},"path":{"type":"string","minLength":1},"expected":{}},"oneOf":[{"title":"Status code assertion","properties":{"kind":{"const":"STATUS_CODE_IN"},"operator":{"const":"IN"},"expected":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"integer","minimum":100,"maximum":599}}},"required":["expected"],"not":{"required":["path"]}},{"title":"JSON path existence assertion","properties":{"kind":{"const":"JSON_PATH_EXISTS"},"operator":{"const":"EXISTS"}},"required":["path"],"not":{"required":["expected"]}},{"title":"JSON path equality assertion","properties":{"kind":{"const":"JSON_PATH_EQUALS"},"operator":{"const":"EQUALS"}},"required":["path","expected"]}]}
