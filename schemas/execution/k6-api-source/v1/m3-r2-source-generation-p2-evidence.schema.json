{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.local/schemas/execution/k6-api-source/v1/m3-r2-source-generation-p2-evidence.schema.json",
  "title": "M3-R2 P2 Source Generation Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "source",
    "acceptedFoundation",
    "fixedDigests",
    "sourceResult",
    "decision",
    "safetyBoundary",
    "evidenceDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "m3-r2-source-generation-p2-evidence/v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "commitSha"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "commitSha": {
          "type": "string",
          "pattern": "^(?:local|[a-f0-9]{40})$"
        }
      }
    },
    "acceptedFoundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineMain",
        "p1AcceptedHead",
        "r0AcceptedHead",
        "p1RunId",
        "p1ArtifactId",
        "r0RunId",
        "r0ArtifactId"
      ],
      "properties": {
        "baselineMain": {
          "$ref": "#/$defs/commitSha"
        },
        "p1AcceptedHead": {
          "$ref": "#/$defs/commitSha"
        },
        "r0AcceptedHead": {
          "$ref": "#/$defs/commitSha"
        },
        "p1RunId": {
          "type": "integer",
          "minimum": 1
        },
        "p1ArtifactId": {
          "type": "integer",
          "minimum": 1
        },
        "r0RunId": {
          "type": "integer",
          "minimum": 1
        },
        "r0ArtifactId": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fixedDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputContract",
        "spec",
        "bundle",
        "compilationEvidence",
        "schemaCatalog"
      ],
      "properties": {
        "inputContract": {
          "$ref": "#/$defs/digest"
        },
        "spec": {
          "$ref": "#/$defs/digest"
        },
        "bundle": {
          "$ref": "#/$defs/digest"
        },
        "compilationEvidence": {
          "$ref": "#/$defs/digest"
        },
        "schemaCatalog": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "sourceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceIdentity",
        "sourceDigest",
        "sourceByteLength",
        "sourceLineCount",
        "operationCount",
        "assertionCount",
        "thresholdCount",
        "renderingPolicyDigest",
        "generatorDescriptorDigest",
        "generationRequestDigest",
        "sourceResultSchemaCatalogDigest",
        "resultDigest"
      ],
      "properties": {
        "sourceIdentity": {
          "$ref": "#/$defs/digest"
        },
        "sourceDigest": {
          "$ref": "#/$defs/digest"
        },
        "sourceByteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16000000
        },
        "sourceLineCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16000000
        },
        "operationCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "assertionCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1280000
        },
        "thresholdCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 320000
        },
        "renderingPolicyDigest": {
          "$ref": "#/$defs/digest"
        },
        "generatorDescriptorDigest": {
          "$ref": "#/$defs/digest"
        },
        "generationRequestDigest": {
          "$ref": "#/$defs/digest"
        },
        "sourceResultSchemaCatalogDigest": {
          "$ref": "#/$defs/digest"
        },
        "resultDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceGenerationContractReady",
        "deterministicSourceRendererReady",
        "sourceGenerationStarted",
        "sourceGenerated",
        "sourceExecuted",
        "executionRuntimeStarted",
        "nextRequiredSlice",
        "repositoryBlockers"
      ],
      "properties": {
        "sourceGenerationContractReady": {
          "const": true
        },
        "deterministicSourceRendererReady": {
          "const": true
        },
        "sourceGenerationStarted": {
          "const": true
        },
        "sourceGenerated": {
          "const": true
        },
        "sourceExecuted": {
          "const": false
        },
        "executionRuntimeStarted": {
          "const": false
        },
        "nextRequiredSlice": {
          "const": "M3-R2-P3"
        },
        "repositoryBlockers": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "safetyBoundary": {
      "$ref": "#/$defs/safetyBoundary"
    },
    "evidenceDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "safetyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "k6Invoked",
        "xk6Invoked",
        "playwrightInvoked",
        "externalProcessExecuted",
        "nodeVmUsed",
        "evalUsed",
        "dynamicImportUsed",
        "targetNetworkAccessed",
        "databaseAccessed",
        "secretAccessed",
        "filesystemCredentialAccessed",
        "temporaryExecutionDirectoryCreated",
        "containerStarted",
        "kubernetesResourceCreated",
        "workerAdded",
        "queueAdded",
        "schedulerAdded",
        "runtimeResultCollected",
        "allureImplemented"
      ],
      "properties": {
        "k6Invoked": {
          "const": false
        },
        "xk6Invoked": {
          "const": false
        },
        "playwrightInvoked": {
          "const": false
        },
        "externalProcessExecuted": {
          "const": false
        },
        "nodeVmUsed": {
          "const": false
        },
        "evalUsed": {
          "const": false
        },
        "dynamicImportUsed": {
          "const": false
        },
        "targetNetworkAccessed": {
          "const": false
        },
        "databaseAccessed": {
          "const": false
        },
        "secretAccessed": {
          "const": false
        },
        "filesystemCredentialAccessed": {
          "const": false
        },
        "temporaryExecutionDirectoryCreated": {
          "const": false
        },
        "containerStarted": {
          "const": false
        },
        "kubernetesResourceCreated": {
          "const": false
        },
        "workerAdded": {
          "const": false
        },
        "queueAdded": {
          "const": false
        },
        "schedulerAdded": {
          "const": false
        },
        "runtimeResultCollected": {
          "const": false
        },
        "allureImplemented": {
          "const": false
        }
      }
    }
  }
}