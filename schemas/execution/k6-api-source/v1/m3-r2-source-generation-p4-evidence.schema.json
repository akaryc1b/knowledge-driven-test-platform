{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.local/schemas/execution/k6-api-source/v1/m3-r2-source-generation-p4-evidence.schema.json",
  "title": "M3-R2 P4 Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "source",
    "acceptedP3",
    "publicationBundle",
    "publicationReceipt",
    "publicationEvidence",
    "decision",
    "safetyBoundary",
    "evidenceDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "m3-r2-source-generation-p4-evidence/v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "commitSha"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "anyOf": [
            {
              "const": "local"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          ]
        }
      }
    },
    "acceptedP3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headSha",
        "runId",
        "artifactId",
        "artifactDigest",
        "evidenceReceiptFileDigest",
        "artifactReceiptBlobSha",
        "evidenceDigest",
        "sourceArtifactDigest",
        "validationEvidenceDigest",
        "sourceDigest"
      ],
      "properties": {
        "headSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "runId": {
          "type": "integer",
          "minimum": 1
        },
        "artifactId": {
          "type": "integer",
          "minimum": 1
        },
        "artifactDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "evidenceReceiptFileDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifactReceiptBlobSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "evidenceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceArtifactDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "validationEvidenceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "publicationBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleId",
        "bundleDigest",
        "manifestDigest",
        "fileCount",
        "totalByteLength",
        "sourceArtifactDigest",
        "validationEvidenceDigest",
        "p3EvidenceDigest"
      ],
      "properties": {
        "bundleId": {
          "type": "string"
        },
        "bundleDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fileCount": {
          "const": 5
        },
        "totalByteLength": {
          "type": "integer",
          "minimum": 5
        },
        "sourceArtifactDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "validationEvidenceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "p3EvidenceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "publicationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId",
        "receiptDigest",
        "logicalUri",
        "publishedAt",
        "storageKind",
        "remote"
      ],
      "properties": {
        "receiptId": {
          "type": "string"
        },
        "receiptDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "logicalUri": {
          "type": "string",
          "pattern": "^kdtp-source-bundle://sha256/[a-f0-9]{64}$"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "storageKind": {
          "const": "CONTENT_ADDRESSED_FILESYSTEM"
        },
        "remote": {
          "const": false
        }
      }
    },
    "publicationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "evidenceDigest"
      ],
      "properties": {
        "evidenceId": {
          "type": "string"
        },
        "evidenceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceBundleContractReady",
        "sourceBundleCreated",
        "sourceManifestCreated",
        "sourceProvenanceBound",
        "sourcePersisted",
        "artifactPublished",
        "remoteArtifactPublished",
        "sourceExecuted",
        "executionRuntimeStarted",
        "nextRequiredSlice",
        "repositoryBlockers"
      ],
      "properties": {
        "sourceBundleContractReady": {
          "const": true
        },
        "sourceBundleCreated": {
          "const": true
        },
        "sourceManifestCreated": {
          "const": true
        },
        "sourceProvenanceBound": {
          "const": true
        },
        "sourcePersisted": {
          "const": true
        },
        "artifactPublished": {
          "const": true
        },
        "remoteArtifactPublished": {
          "const": false
        },
        "sourceExecuted": {
          "const": false
        },
        "executionRuntimeStarted": {
          "const": false
        },
        "nextRequiredSlice": {
          "const": "M3-R2-P5"
        },
        "repositoryBlockers": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "safetyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactStorageAccessed",
        "artifactStorageDirectoryCreated",
        "sourcePersisted",
        "artifactPublished",
        "remoteArtifactPublished",
        "sourceExecuted",
        "executionRuntimeStarted",
        "k6Invoked",
        "xk6Invoked",
        "playwrightInvoked",
        "externalProcessExecuted",
        "nodeVmUsed",
        "evalUsed",
        "dynamicImportUsed",
        "targetNetworkAccessed",
        "databaseAccessed",
        "secretAccessed",
        "filesystemCredentialAccessed",
        "temporaryExecutionDirectoryCreated",
        "containerStarted",
        "kubernetesResourceCreated",
        "workerAdded",
        "queueAdded",
        "schedulerAdded",
        "runtimeResultCollected",
        "allureImplemented"
      ],
      "properties": {
        "artifactStorageAccessed": {
          "const": true
        },
        "artifactStorageDirectoryCreated": {
          "const": true
        },
        "sourcePersisted": {
          "const": true
        },
        "artifactPublished": {
          "const": true
        },
        "remoteArtifactPublished": {
          "const": false
        },
        "sourceExecuted": {
          "const": false
        },
        "executionRuntimeStarted": {
          "const": false
        },
        "k6Invoked": {
          "const": false
        },
        "xk6Invoked": {
          "const": false
        },
        "playwrightInvoked": {
          "const": false
        },
        "externalProcessExecuted": {
          "const": false
        },
        "nodeVmUsed": {
          "const": false
        },
        "evalUsed": {
          "const": false
        },
        "dynamicImportUsed": {
          "const": false
        },
        "targetNetworkAccessed": {
          "const": false
        },
        "databaseAccessed": {
          "const": false
        },
        "secretAccessed": {
          "const": false
        },
        "filesystemCredentialAccessed": {
          "const": false
        },
        "temporaryExecutionDirectoryCreated": {
          "const": false
        },
        "containerStarted": {
          "const": false
        },
        "kubernetesResourceCreated": {
          "const": false
        },
        "workerAdded": {
          "const": false
        },
        "queueAdded": {
          "const": false
        },
        "schedulerAdded": {
          "const": false
        },
        "runtimeResultCollected": {
          "const": false
        },
        "allureImplemented": {
          "const": false
        }
      }
    },
    "evidenceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
