{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.local/schemas/access/v1/project-membership-record.schema.json",
  "title": "Project Membership Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "projectId", "subject", "roles", "status", "validFrom", "validUntil",
    "revision", "createdAt", "updatedAt", "history"
  ],
  "properties": {
    "schemaVersion": { "const": "project-membership-record/v1" },
    "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "subject": { "type": "string", "minLength": 1, "maxLength": 512 },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["VIEWER", "AUTHOR", "REVIEWER", "PUBLISHER", "AUDITOR", "AUTOMATION", "PROJECT_ADMIN"] }
    },
    "status": { "enum": ["ACTIVE", "SUSPENDED", "REVOKED"] },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": ["string", "null"], "format": "date-time" },
    "revision": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/historyEvent" }
    }
  },
  "$defs": {
    "historyEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "type", "fromStatus", "toStatus", "actor", "at", "reason"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["CREATED", "UPDATED"] },
        "fromStatus": { "type": ["string", "null"] },
        "toStatus": { "enum": ["ACTIVE", "SUSPENDED", "REVOKED"] },
        "actor": { "type": "string", "minLength": 1, "maxLength": 512 },
        "at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
