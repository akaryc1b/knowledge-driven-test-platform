{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.local/schemas/governance/v1/review-decision.schema.json",
  "title": "Knowledge Review Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "projectId",
    "knowledgeKey",
    "knowledgeId",
    "version",
    "reviewRevision",
    "decision",
    "reviewer",
    "at",
    "reason"
  ],
  "properties": {
    "schemaVersion": { "const": "knowledge-review-decision/v1" },
    "decisionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{7,255}$" },
    "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "knowledgeKey": { "type": "string", "minLength": 7, "maxLength": 320 },
    "knowledgeId": { "type": "string", "minLength": 5, "maxLength": 255 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "reviewRevision": { "type": "integer", "minimum": 1 },
    "decision": { "enum": ["APPROVE", "REQUEST_CHANGES"] },
    "reviewer": { "type": "string", "minLength": 1, "maxLength": 512 },
    "at": { "type": "string", "format": "date-time" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
  }
}
