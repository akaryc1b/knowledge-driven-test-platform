{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.example/schemas/capability/v1/test-capability.schema.json",
  "title": "Test Capability v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "capabilityId", "version", "name", "targetKinds", "intentKind",
    "inputContract", "assertionContract", "thresholdContract", "dependencyRules",
    "enabled", "source", "tags"
  ],
  "properties": {
    "schemaVersion": { "const": "test-capability/v1" },
    "capabilityId": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/semver" },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "targetKinds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/kind" }
    },
    "intentKind": { "$ref": "#/$defs/kind" },
    "inputContract": { "$ref": "#/$defs/contract" },
    "assertionContract": { "$ref": "#/$defs/contract" },
    "thresholdContract": { "$ref": "#/$defs/contract" },
    "dependencyRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilityId", "version", "required", "targetScope"],
        "properties": {
          "capabilityId": { "$ref": "#/$defs/identifier" },
          "version": { "$ref": "#/$defs/semver" },
          "required": { "type": "boolean" },
          "targetScope": { "$ref": "#/$defs/kind" }
        }
      }
    },
    "enabled": { "type": "boolean" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "reference": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "tags": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "#/$defs/kind" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,255}$" },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "contract": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": { "schemaVersion": { "const": "capability-contract/v1" } }
    }
  }
}
