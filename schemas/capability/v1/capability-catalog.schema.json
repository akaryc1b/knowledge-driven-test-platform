{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.example/schemas/capability/v1/capability-catalog.schema.json",
  "title": "Capability Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "digest", "capabilities"],
  "properties": {
    "schemaVersion": { "const": "capability-catalog/v1" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capabilities": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "test-capability.schema.json" }
    }
  }
}
