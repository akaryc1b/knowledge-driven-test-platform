{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.local/schemas/release/v3/m2-production-promotion-evidence.schema.json",
  "title": "M2 Production Promotion Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "version",
    "generatedAt",
    "source",
    "digests",
    "promotionSource",
    "mainBranchFinalCi",
    "imageRelease",
    "secrets",
    "targetClusterValidation",
    "approvals",
    "decision"
  ],
  "properties": {
    "schemaVersion": {
      "const": "m2-production-promotion-evidence/v1"
    },
    "releaseId": {
      "const": "M2-RC1"
    },
    "version": {
      "const": "0.12.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "commitSha"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": "string",
          "pattern": "^(?:local|[a-f0-9]{40})$"
        }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionPromotion",
        "candidate",
        "postMergeAcceptance"
      ],
      "properties": {
        "productionPromotion": {
          "$ref": "#/$defs/rawDigest"
        },
        "candidate": {
          "$ref": "#/$defs/rawDigest"
        },
        "postMergeAcceptance": {
          "$ref": "#/$defs/rawDigest"
        }
      }
    },
    "promotionSource": {
      "type": "object"
    },
    "mainBranchFinalCi": {
      "type": "object"
    },
    "imageRelease": {
      "type": "object"
    },
    "secrets": {
      "type": "object"
    },
    "targetClusterValidation": {
      "type": "object"
    },
    "approvals": {
      "type": "object"
    },
    "decision": {
      "type": "object",
      "required": [
        "productionEligible",
        "resolvedBlockers",
        "openBlockers"
      ],
      "properties": {
        "productionEligible": {
          "type": "boolean"
        },
        "resolvedBlockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "openBlockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "rawDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
