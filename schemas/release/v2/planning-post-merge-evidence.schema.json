{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.local/schemas/release/v2/planning-post-merge-evidence.schema.json",
  "title": "M2 Governed Planning Post-Merge Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "version",
    "generatedAt",
    "source",
    "digests",
    "merge",
    "verification",
    "decision"
  ],
  "properties": {
    "schemaVersion": {
      "const": "m2-governed-planning-post-merge-evidence/v1"
    },
    "releaseId": {
      "const": "M2-RC1"
    },
    "version": {
      "const": "0.12.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "commitSha"
      ],
      "properties": {
        "branch": {
          "type": "string"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^(?:local|[a-f0-9]{40})$"
        }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance",
        "sourceCandidate"
      ],
      "properties": {
        "acceptance": {
          "$ref": "#/$defs/digest"
        },
        "sourceCandidate": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "merge": {
      "type": "object"
    },
    "verification": {
      "type": "object"
    },
    "decision": {
      "type": "object"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
