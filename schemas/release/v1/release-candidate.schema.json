{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.local/schemas/release/v1/release-candidate.schema.json",
  "title": "M1 Read-Only Release Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "version", "status", "candidateBranch", "predecessorHeadSha", "stack", "requiredChecks", "businessRoutes", "decision"],
  "properties": {
    "schemaVersion": { "const": "m1-read-only-release-candidate/v1" },
    "releaseId": { "const": "M1-RC1" },
    "version": { "type": "string", "pattern": "^0\\.12\\.0$" },
    "status": { "const": "CANDIDATE" },
    "candidateBranch": { "const": "agent/m1-k-release-acceptance" },
    "predecessorHeadSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "stack": { "type": "array", "minItems": 10, "maxItems": 10, "items": { "$ref": "#/$defs/stackEntry" } },
    "requiredChecks": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "type": "string" } },
    "businessRoutes": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "type": "string" } },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productionEligible", "blockers"],
      "properties": {
        "productionEligible": { "const": false },
        "blockers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "stackEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slice", "pr", "base", "head", "headSha"],
      "properties": {
        "slice": { "type": "string", "pattern": "^M1-[A-J]$" },
        "pr": { "type": "integer", "minimum": 1, "maximum": 10 },
        "base": { "type": "string", "minLength": 1 },
        "head": { "type": "string", "pattern": "^agent/m1-[a-z0-9-]+$" },
        "headSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    }
  }
}
