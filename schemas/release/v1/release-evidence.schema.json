{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.local/schemas/release/v1/release-evidence.schema.json",
  "title": "M1 Read-Only Release Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "version", "generatedAt", "source", "digests", "stack", "verification", "artifacts", "decision"],
  "properties": {
    "schemaVersion": { "const": "m1-read-only-release-evidence/v1" },
    "releaseId": { "const": "M1-RC1" },
    "version": { "const": "0.12.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commitSha"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "commitSha": { "type": "string", "pattern": "^(?:local|[a-f0-9]{40})$" }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "deploymentManifests"],
      "properties": {
        "candidate": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "deploymentManifests": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slices", "pullRequests", "continuous"],
      "properties": {
        "slices": { "const": 10 },
        "pullRequests": { "type": "array", "minItems": 10, "maxItems": 10, "items": { "type": "integer" } },
        "continuous": { "const": true }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredChecks", "businessRoutes"],
      "properties": {
        "requiredChecks": { "type": "array", "minItems": 6, "items": { "type": "string" } },
        "businessRoutes": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "string" } }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "deployment"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "localImageId", "registryDigest"],
          "properties": {
            "reference": { "type": "string", "minLength": 1 },
            "localImageId": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
            "registryDigest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resourceCount", "namespace"],
          "properties": {
            "resourceCount": { "const": 7 },
            "namespace": { "const": "kdtp-system" }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "productionEligible", "blockers"],
      "properties": {
        "status": { "const": "CANDIDATE" },
        "productionEligible": { "const": false },
        "blockers": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
