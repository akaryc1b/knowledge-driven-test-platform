{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.local/schemas/planning/v1/test-intent.schema.json",
  "title": "Test Intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "intentId",
    "planInputFingerprint",
    "intentKind",
    "targetId",
    "capability",
    "sourceKnowledge",
    "policyEntryId",
    "input",
    "assertions",
    "thresholds",
    "dependencies",
    "tags"
  ],
  "properties": {
    "schemaVersion": {
      "const": "test-intent/v1"
    },
    "intentId": {
      "type": "string",
      "pattern": "^intent-[a-f0-9]{16}$"
    },
    "planInputFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "intentKind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "targetId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,255}$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "version"
      ],
      "properties": {
        "capabilityId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,255}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "sourceKnowledge": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledgeId",
          "version",
          "boundaryKey",
          "snapshotId",
          "snapshotDigest"
        ],
        "properties": {
          "knowledgeId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{1,31}(?:-[A-Z0-9][A-Z0-9]{0,31}){2,7}$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "boundaryKey": {
            "type": "string"
          },
          "snapshotId": {
            "type": "string",
            "pattern": "^kb-[a-z0-9-]+-[a-f0-9]{12}$"
          },
          "snapshotDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "policyEntryId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,255}$"
    },
    "input": {
      "type": "object"
    },
    "assertions": {
      "type": "object"
    },
    "thresholds": {
      "type": "object"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^intent-[a-f0-9]{16}$"
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
      }
    }
  }
}
