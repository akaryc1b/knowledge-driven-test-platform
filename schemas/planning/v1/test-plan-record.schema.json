{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.local/schemas/planning/v1/test-plan-record.schema.json",
  "title": "Test Plan Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "projectId", "environmentId", "releaseId", "status", "revision", "inputFingerprint", "knowledgeSnapshot", "capabilityCatalog", "contentDigest", "planningResult", "createdAt", "createdBy", "updatedAt", "updatedBy", "history"],
  "properties": {
    "schemaVersion": { "const": "test-plan-record/v1" },
    "planId": { "type": "string", "pattern": "^tp-[a-z0-9-]+-[a-f0-9]{12}$" },
    "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "environmentId": { "type": "string" },
    "releaseId": { "type": "string" },
    "status": { "enum": ["DRAFT", "REVIEWING", "APPROVED", "FROZEN", "SUPERSEDED", "ARCHIVED"] },
    "revision": { "type": "integer", "minimum": 1 },
    "inputFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "knowledgeSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "digest"],
      "properties": {
        "snapshotId": { "type": "string" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "capabilityCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "contentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "planningResult": { "$ref": "test-planning-result.schema.json" },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string", "minLength": 3 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "updatedBy": { "type": "string", "minLength": 3 },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "test-plan-history-event.schema.json" }
    }
  }
}
