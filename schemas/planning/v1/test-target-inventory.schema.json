{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.local/schemas/planning/v1/test-target-inventory.schema.json",
  "title": "Test Target Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inventoryId",
    "projectId",
    "environmentId",
    "releaseId",
    "targets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "test-target-inventory/v1"
    },
    "inventoryId": {
      "type": "string",
      "pattern": "^target-inventory-[a-z0-9-]+-[a-f0-9]{12}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
    },
    "environmentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetId",
          "kind",
          "name",
          "tags",
          "attributes"
        ],
        "properties": {
          "targetId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{2,255}$"
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
            }
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    }
  }
}
