{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.local/schemas/planning/v1/test-planning-request.schema.json",
  "title": "Test Planning Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inputFingerprint",
    "projectId",
    "environmentId",
    "releaseId",
    "knowledgeSnapshotId",
    "knowledgeSnapshotDigest",
    "knowledgeSnapshot",
    "plannerVersion",
    "capabilityCatalogVersion",
    "capabilityCatalogDigest",
    "targetInventory",
    "planningPolicy",
    "createdAt",
    "createdBy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "test-planning-request/v1"
    },
    "inputFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
    },
    "environmentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "knowledgeSnapshotId": {
      "type": "string",
      "pattern": "^kb-[a-z0-9-]+-[a-f0-9]{12}$"
    },
    "knowledgeSnapshotDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "knowledgeSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "snapshotId",
        "digest",
        "projectId",
        "environmentId",
        "releaseId",
        "createdBy",
        "createdAt",
        "reason",
        "snapshot"
      ],
      "properties": {
        "schemaVersion": {
          "const": "knowledge-snapshot-envelope/v1"
        },
        "snapshotId": {
          "type": "string",
          "pattern": "^kb-[a-z0-9-]+-[a-f0-9]{12}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
        },
        "environmentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "releaseId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "object",
          "required": [
            "snapshotId",
            "digest",
            "schemaVersion",
            "context",
            "rules",
            "resolution"
          ],
          "properties": {
            "snapshotId": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "schemaVersion": {
              "const": 1
            },
            "context": {
              "type": "object"
            },
            "rules": {
              "type": "array",
              "minItems": 1
            },
            "resolution": {
              "type": "array"
            }
          }
        }
      }
    },
    "plannerVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "capabilityCatalogVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "capabilityCatalogDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetInventory": {
      "$ref": "test-target-inventory.schema.json"
    },
    "planningPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "version",
        "entries",
        "exemptions"
      ],
      "properties": {
        "policyId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,255}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "policyEntryId",
              "priority",
              "selectors",
              "capabilityRefs",
              "mandatory"
            ],
            "properties": {
              "policyEntryId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._:-]{2,255}$"
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "selectors": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "knowledgeIds": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "boundaryKeys": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "knowledgeTags": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "targetIds": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "targetKinds": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "targetTags": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "capabilityRefs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "capabilityId",
                    "version"
                  ],
                  "properties": {
                    "capabilityId": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9._:-]{2,255}$"
                    },
                    "version": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                    }
                  }
                }
              },
              "mandatory": {
                "type": "boolean"
              }
            }
          }
        },
        "exemptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exemptionId",
              "knowledgeId",
              "knowledgeVersion",
              "targetId",
              "capabilityId",
              "capabilityVersion",
              "reason",
              "owner"
            ],
            "properties": {
              "exemptionId": {
                "type": "string",
                "pattern": "^exemption-[a-f0-9]{16}$"
              },
              "knowledgeId": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]{1,31}(?:-[A-Z0-9][A-Z0-9]{0,31}){2,7}$"
              },
              "knowledgeVersion": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              },
              "targetId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._:-]{2,255}$"
              },
              "capabilityId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._:-]{2,255}$"
              },
              "capabilityVersion": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
