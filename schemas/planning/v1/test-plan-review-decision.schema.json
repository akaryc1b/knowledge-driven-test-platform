{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdtp.local/schemas/planning/v1/test-plan-review-decision.schema.json",
  "title": "Test Plan Review Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decisionId", "planId", "projectId", "planRevision", "decision", "reviewer", "at", "reason", "evidence"],
  "properties": {
    "schemaVersion": { "const": "test-plan-review-decision/v1" },
    "decisionId": { "type": "string", "pattern": "^plan-decision-[a-f0-9]{16}$" },
    "planId": { "type": "string", "pattern": "^tp-[a-z0-9-]+-[a-f0-9]{12}$" },
    "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "planRevision": { "type": "integer", "minimum": 1 },
    "decision": { "enum": ["APPROVE", "REQUEST_CHANGES"] },
    "reviewer": { "type": "string", "minLength": 3, "maxLength": 256 },
    "at": { "type": "string", "format": "date-time" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "evidence": { "type": "object" }
  }
}
